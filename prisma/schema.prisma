// Prisma Schema for To-Do List Application
// Using MySQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management Models
// ============================================

model User {
  UserID       Int       @id @default(autoincrement())
  UserName     String    @unique @db.VarChar(50)
  Email        String    @unique @db.VarChar(100)
  PasswordHash String    @db.VarChar(255)
  CreatedAt    DateTime? @default(now()) @db.DateTime(0)

  // Relations
  userRoles    UserRole[]
  projects     Project[]
  assignedTasks Task[]     @relation("AssignedUser")
  comments     TaskComment[]
  history      TaskHistory[]

  @@index([Email], map: "idx_email")
  @@index([UserName], map: "idx_username")
  @@map("users")
}

model Role {
  RoleID   Int        @id @default(autoincrement())
  RoleName String     @unique @db.VarChar(50)

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  UserRoleID Int  @id @default(autoincrement())
  UserID     Int
  RoleID     Int

  // Relations
  user       User @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  role       Role @relation(fields: [RoleID], references: [RoleID], onDelete: Cascade)

  @@unique([UserID, RoleID], map: "unique_user_role")
  @@index([RoleID], map: "RoleID")
  @@map("userroles")
}

// ============================================
// Project Management Models
// ============================================

model Project {
  ProjectID   Int       @id @default(autoincrement())
  ProjectName String    @db.VarChar(100)
  Description String?   @db.VarChar(255)
  CreatedBy   Int
  CreatedAt   DateTime? @default(now()) @db.DateTime(0)

  // Relations
  creator     User       @relation(fields: [CreatedBy], references: [UserID], onUpdate: NoAction)
  taskLists   TaskList[]

  @@index([CreatedBy], map: "idx_created_by")
  @@index([CreatedAt], map: "idx_created_at")
  @@map("projects")
}

model TaskList {
  ListID    Int     @id @default(autoincrement())
  ProjectID Int
  ListName  String  @db.VarChar(100)

  // Relations
  project   Project @relation(fields: [ProjectID], references: [ProjectID], onDelete: Cascade)
  tasks     Task[]

  @@index([ProjectID], map: "idx_project_id")
  @@map("tasklists")
}

// ============================================
// Task Models
// ============================================

model Task {
  TaskID      Int       @id @default(autoincrement())
  ListID      Int
  AssignedTo  Int?
  Title       String    @db.VarChar(100)
  Description String?   @db.VarChar(255)
  Priority    String?   @default("Medium") @db.VarChar(10)
  Status      String?   @default("Pending") @db.VarChar(20)
  DueDate     DateTime? @db.Date
  CreatedAt   DateTime? @default(now()) @db.DateTime(0)

  // Relations
  taskList    TaskList       @relation(fields: [ListID], references: [ListID], onDelete: Cascade)
  assignedUser User?         @relation("AssignedUser", fields: [AssignedTo], references: [UserID], onUpdate: NoAction)
  comments    TaskComment[]
  history     TaskHistory[]

  @@index([ListID], map: "idx_list_id")
  @@index([AssignedTo], map: "idx_assigned_to")
  @@index([Status], map: "idx_status")
  @@index([Priority], map: "idx_priority")
  @@index([DueDate], map: "idx_due_date")
  @@index([ListID, Status], map: "idx_list_status")
  @@map("tasks")
}

model TaskComment {
  CommentID   Int      @id @default(autoincrement())
  TaskID      Int
  UserID      Int
  CommentText String   @db.VarChar(255)
  CreatedAt   DateTime? @default(now()) @db.DateTime(0)

  // Relations
  task        Task     @relation(fields: [TaskID], references: [TaskID], onDelete: Cascade)
  user        User     @relation(fields: [UserID], references: [UserID], onDelete: Cascade)

  @@index([TaskID], map: "idx_task_id")
  @@index([UserID], map: "UserID")
  @@index([CreatedAt], map: "idx_created_at")
  @@map("taskcomments")
}

model TaskHistory {
  HistoryID  Int      @id @default(autoincrement())
  TaskID     Int
  ChangedBy  Int
  ChangeType String   @db.VarChar(50)
  ChangeTime DateTime? @default(now()) @db.DateTime(0)

  // Relations
  task       Task     @relation(fields: [TaskID], references: [TaskID], onDelete: Cascade)
  changedByUser User  @relation(fields: [ChangedBy], references: [UserID], onDelete: Cascade)

  @@index([TaskID], map: "idx_task_id")
  @@index([ChangedBy], map: "ChangedBy")
  @@index([ChangeTime], map: "idx_change_time")
  @@map("taskhistory")
}
